# The hugging face token for pyannotate etc
HF_READ_TOKEN=

# The deezer arl, login -> get from cookies
DEEZER_ARL=

# Vocal separation runs locally with the BS-RoFormer worker
SPLIT_BACKEND=local
# Torch threads for the local worker (physical cores) and its overlap (quality/speed)
SEPARATION_THREADS=8
SEPARATION_OVERLAP=2

# Lyrics transcription runs locally with the turbo-lyrics worker
TRANSCRIBE_BACKEND=local
TRANSCRIBE_THREADS=8
# Known lyrics (lrclib): shadow = also force-align them and keep the result for comparison, prefer = use them when
# the alignment passes its quality gate (no Whisper run, no LLM correction), off = transcription only
TRANSCRIBE_REFERENCE_MODE=shadow

# OpenAI API key for direct GPT-6 Luna lyrics correction and translation (preferred when set)
OPENAI_API_KEY=

# OpenRouter is used when no direct OpenAI key is set, or for non-OpenAI translation models
OPENROUTER_API_KEY=

# Translation model override (lyrics correction uses openai/gpt-6-luna)
LYRICS_TRANSLATION_MODEL=openai/gpt-6-luna

# Resend API key for password reset emails
RESEND_API_KEY=

# Flask secret key (set a fixed value for production to persist sessions across restarts)
SECRET_KEY=

# Server configuration
HOST=0.0.0.0
PORT=5000
DEBUG=False

# Base URL for email links
BASE_URL=http://localhost:5000

# Default admin credentials (only used for display, not auto-creation)
ADMIN_USERNAME=
ADMIN_PASSWORD=
